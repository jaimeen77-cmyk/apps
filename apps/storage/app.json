{
  "id": "storage",
  "title": "Storage",
  "description": "Head-unit storage: free space per file system, RAM in use, per-app size, with a usage alert",
  "version": "1.0.2",
  "vendor": "custom",
  "loggingId": "OST1",
  "iconGlyph": "GB",
  "signals": {},
  "screens": [
    {
      "name": "MAIN",
      "kind": "canvas",
      "title": "Storage",
      "buttons": [
        [
          "BTN_ACTION",
          "Refresh"
        ],
        [
          "BTN_PAGE",
          "Next page"
        ],
        [
          "BTN_SETTINGS",
          "Settings"
        ]
      ]
    }
  ],
  "startWidget": {
    "comment": "Home-screen widget (eDrive / Drive Recorder layout). Big widget shows a drawn gauge of the apps file system; small widget shows text + the layout progress bar. Turns red at the alert threshold.",
    "name": "Storage",
    "layout": "LT_Table_OnlineApps_DriveRecorderWidget",
    "image": "BackgroundImage1",
    "scale": 2,
    "size": [
      384,
      256
    ],
    "safe": [
      0.09,
      0.1
    ],
    "cells": {
      "ErrorInfo": [
        false,
        "Bool"
      ],
      "background": [
        true,
        "Bool"
      ],
      "ProgressbarVisible": [
        false,
        "Bool"
      ],
      "TextRecordings": [
        "",
        "Text"
      ]
    }
  },
  "settings": [
    {
      "key": "alertPct",
      "label": "Alert when apps storage above",
      "type": "number",
      "unit": "%",
      "default": 80,
      "steps": [
        70,
        80,
        90,
        95
      ]
    },
    {
      "key": "page",
      "label": "Start page",
      "type": "choice",
      "default": "disks",
      "options": [
        [
          "disks",
          "Disks"
        ],
        [
          "apps",
          "Apps"
        ]
      ]
    },
    {
      "key": "showRam",
      "label": "Show RAM disks (tmpfs)",
      "type": "bool",
      "default": false
    },
    {
      "key": "showRo",
      "label": "Show read-only system partitions",
      "type": "bool",
      "default": true
    },
    {
      "key": "units",
      "label": "Size units",
      "type": "choice",
      "default": "bin",
      "options": [
        [
          "bin",
          "GB = 1024 MB (like df -h)"
        ],
        [
          "dec",
          "GB = 1000 MB"
        ]
      ]
    },
    {
      "key": "theme",
      "label": "Colour theme",
      "type": "choice",
      "default": "m_tricolour",
      "options": [
        [
          "m_red",
          "M Red"
        ],
        [
          "m_tricolour",
          "M Tricolour"
        ],
        [
          "ice",
          "Ice White"
        ],
        [
          "amber",
          "Night Amber"
        ]
      ]
    },
    {
      "key": "demo",
      "label": "Preview data (emulator)",
      "type": "choice",
      "default": "auto",
      "options": [
        [
          "auto",
          "Auto (real df on car, demo off-car)"
        ],
        [
          "ok",
          "Demo 44%"
        ],
        [
          "warn",
          "Demo 78%"
        ],
        [
          "crit",
          "Demo 95%"
        ]
      ]
    }
  ],
