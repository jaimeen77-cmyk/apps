{
  "id": "cluster_redline",
  "title": "Cluster Redline",
  "description": "Independent cluster/HUD RPM and navigation with retained component rendering and batched custom settings",
  "version": "1.2.53",
  "vendor": "custom",
  "loggingId": "OAC7",
  "iconGlyph": "rpm",
  "mguAppStartType": "autostart",
  "signals": {
    "de.bmw.infotainment.vehicle.CDS": {
      "statusEngineSpeed2": "rs",
      "statusEngineTemperature": "rs",
      "statusBattery2": "rs"
    },
    "de.bmw.infotainment.drivingexcitement.FES": {
      "statusFESVehicleDynamicSwitchHMI": "rs",
      "statusActualValueTorque2": "rs",
      "statusSwitchDriveDynamicSport2": "rs"
    },
    "de.bmw.infrastructure.VehicleInformation": {
      "_optional": "current gear display; RPM and shift alerts still work without it",
      "statusGearboxDrive": "s",
      "DataPowerTrain2": "s"
    },
    "de.bmw.infotainment.misc.MDrive": {
      "_optional": "S/M programme; regular gear, RPM and shift alerts work without it",
      "dataDisplayGearbox": "s"
    },
    "de.bmw.infotainment.navigation.guiding.Guidance": {
      "_optional": "Read-only guidance state and maneuver data; missing navigation inputs preserve stock HUD guidance",
      "guidanceState": "rs",
      "_instances": "Main_Instance",
      "guidingProvider": "rs",
      "conclusiveDart": "rs"
    },
    "de.bmw.infotainment.sdi.aap.androidautoprojectedmanager.AndroidAutoProjectedManager": {
      "_optional": "Read-only phone guidance status; missing inputs preserve stock HUD guidance",
      "_instances": "AndroidAutoProjectedManagerInst1",
      "projectedGuidanceActive": "rs",
      "projectedGuidanceMetadataAvailable": "rs"
    },
    "de.bmw.infotainment.a4a.carplay.CarPlayManager": {
      "_optional": "Read-only phone guidance status; missing inputs preserve stock HUD guidance",
      "_instances": "CarPlayManagerInst1",
      "projectedGuidanceActive": "rs",
      "projectedGuidanceMetadataAvailable": "rs"
    },
    "de.bmw.infotainment.navigation.guiding.GuidanceRenderedContent": {
      "_optional": "Read existing HUD guidance events only; unavailable views preserve stock HUD guidance",
      "_instances": "Main_Instance",
      "registeredViews": "r",
      "_methods": [
        "getViewConfig",
        "getViewContent"
      ]
    },
    "de.bmw.infotainment.navigation.guiding.GuidanceEventList": {
      "_optional": "Read-only current route event query for combined phone navigation and Redline HUD; missing events preserve stock HUD guidance",
      "_instances": "Main_Instance",
      "_methods": [
        "queryContent"
      ]
    },
    "de.bmw.infotainment.vehicle.CDS2": {
      "_optional": "Optional auxiliary acceleration and oil temperature; unavailable values display --",
      "statusInjectionVolume": "rs",
      "statusLateralAccelerationMassCenter": "rs",
      "statusLongitudinalAccelerationMassCenter": "rs"
    },
    "de.bmw.infrastructure.EnvironmentalInformation": {
      "_optional": "Optional outside temperature; unavailable values display --",
      "ExteriorTemperature": "rs"
    },
    "de.bmw.infotainment.KombiIF": {
      "_optional": "Average fuel economy unavailable",
      "statusBordcomputerAverage": "rs"
    },
    "com.harman.infotainment.systemfunctions.tasu.tasu.InternalTasu": {
      "_optional": "Battery voltage unavailable",
      "_instances": "SystemFunctionsInternalTasuInst1",
      "_methods": [
        "sendTasuRequest"
      ],
      "_broadcasts": [
        "sendTasuResponse"
      ]
    },
    "de.bmw.infotainment.navigation.projectedmodeguiding.ProjectedModeGuiding": {
      "_optional": "CarPlay lane guidance unavailable",
      "_instances": "Main_Instance",
      "currentLaneGuiding": "rs"
    }
  },
