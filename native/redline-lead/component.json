{
  "id": "redline-lead",
  "kind": "tool",
  "version": "0.8.0",
  "title": "Cluster Redline lead-car helper",
  "description": "The car ahead, the road users and the lane lines for Cluster Redline's HUD, from the front camera's objects and lane boundaries and the radar (read only, root: apps are not allowed these services)",
  "mguHmi": [
    "ID7",
    "ID8"
  ],
  "optional": true,
  "uninstallable": true,
  "files": [
    {
      "path": "redline-lead.js",
      "mode": "0644"
    },
    {
      "path": "redline-someip",
      "mode": "0755"
    },
    {
      "path": "share.js",
      "mode": "0644"
    }
  ],
  "units": [
    {
      "name": "redline-lead.service",
      "from": "redline-lead.service"
    }
  ],
  "enable": [
    {
      "unit": "redline-lead.service",
      "target": "multi-user.target"
    }
  ],
  "restart": [
    "redline-lead.service"
  ]
}
